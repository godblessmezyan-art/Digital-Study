{
  "name": "digital-study",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @digital-study/web dev",
    "dev:static": "node scripts/serve-web.mjs",
    "dev:api": "pnpm --filter @digital-study/api start:dev",
    "build": "pnpm run build:shared && pnpm run build:web && pnpm run build:api",
    "build:shared": "pnpm --filter @digital-study/shared build",
    "build:web": "pnpm --filter @digital-study/web build",
    "build:api": "pnpm --filter @digital-study/api build",
    "build:cloudflare": "pnpm run build:shared && pnpm run build:web",
    "deploy:cloudflare": "wrangler deploy",
    "sync-content": "node scripts/sync-content.mjs",
    "migrate-content-storage": "node scripts/migrate-content-storage.mjs",
    "import:legacy-study": "node scripts/import-legacy-study.mjs",
    "build-content-index": "node scripts/build-content-index.mjs",
    "validate-content": "node scripts/validate-content.mjs",
    "prisma:generate": "prisma generate --schema database/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema database/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema database/schema.prisma",
    "prisma:seed": "pnpm --filter @digital-study/api prisma:seed"
  },
  "devDependencies": {
    "@prisma/client": "6.16.2",
    "prisma": "6.16.2",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=22"
  }
}
