generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  DRAFT
  PUBLISHED
}

enum GenerationStatus {
  QUEUED
  GENERATING
  REVIEWING
  COMPLETED
  FAILED
  CANCELLED
}

enum GitSyncStatus {
  NEVER_SYNCED
  PENDING
  SYNCING
  SYNCED
  OUTDATED
  CONFLICT
  ERROR
}

enum GitSyncOperation {
  UPSERT
  DELETE
}

enum ShelfReadingStatus {
  WANT_TO_READ
  READING
  COMPLETED
}

enum ReadingEntryType {
  NOTE
  QUOTE
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PlanTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanTaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Book {
  id           Int        @id @default(autoincrement())
  slug         String     @unique @db.VarChar(160)
  title        String     @db.VarChar(255)
  author       String?    @db.VarChar(160)
  summary      String?    @db.Text
  cover        String?    @db.VarChar(255)
  contentPath  String     @db.VarChar(500)
  status       BookStatus @default(DRAFT)
  publishedAt  DateTime?
  categoryId   Int?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contentHash  String?    @db.VarChar(64)
  deletedAt    DateTime?
  gitSync      BookGitSync?
  gitSyncJobs  GitSyncJob[]
  shelfEntries UserShelfBook[]
  readingEntries ReadingEntry[]
  tagLinks     BookTag[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("books")
}

model Tag {
  id        Int       @id @default(autoincrement())
  slug      String    @unique @db.VarChar(120)
  name      String    @unique @db.VarChar(80)
  books     BookTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tags")
}

model BookTag {
  bookId Int
  tagId  Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([tagId])
  @@map("book_tags")
}

model UserShelfBook {
  id         Int                @id @default(autoincrement())
  ownerId    String             @db.VarChar(160)
  bookId     Int
  book       Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status     ShelfReadingStatus @default(WANT_TO_READ)
  progress   Int                @default(0)
  lastReadAt DateTime?
  addedAt    DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([ownerId, bookId])
  @@index([ownerId, lastReadAt])
  @@map("user_shelf_books")
}

model ReadingEntry {
  id        String           @id @default(uuid()) @db.VarChar(36)
  ownerId   String           @db.VarChar(160)
  type      ReadingEntryType
  title     String?          @db.VarChar(255)
  content   String           @db.Text
  source    String?          @db.VarChar(255)
  pageLabel String?          @db.VarChar(80)
  chapterId String?          @db.VarChar(191)
  chapterTitle String?       @db.VarChar(255)
  quote     String?          @db.Text
  anchor    Json?
  tags      Json?
  readingProgress Int?
  bookId    Int?
  book      Book?            @relation(fields: [bookId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([ownerId, type, updatedAt])
  @@index([bookId])
  @@index([ownerId, bookId, chapterId])
  @@map("reading_entries")
}

model JournalEntry {
  id           String   @id @default(uuid()) @db.VarChar(36)
  ownerId      String   @db.VarChar(160)
  title        String   @db.VarChar(255)
  content      String   @db.Text
  entryDate    DateTime @db.Date
  tags         Json
  mood         String?  @db.VarChar(80)
  weather      String?  @db.VarChar(80)
  worldPeriod  String?  @db.VarChar(40)
  location     String?  @db.VarChar(255)
  coverImage   String?  @db.VarChar(500)
  relatedBooks Json?
  relatedNotes Json?
  isPrivate    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, entryDate])
  @@index([ownerId, updatedAt])
  @@map("journal_entries")
}

model JournalTemplate {
  id          String   @id @default(uuid()) @db.VarChar(36)
  ownerId     String   @db.VarChar(160)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  content     String   @db.Text
  tags        Json
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  isBuiltin   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, isActive, updatedAt])
  @@map("journal_templates")
}

model Plan {
  id          String     @id @default(uuid()) @db.VarChar(36)
  ownerId     String     @db.VarChar(160)
  title       String     @db.VarChar(255)
  description String?    @db.Text
  status      PlanStatus @default(DRAFT)
  startDate   DateTime?  @db.Date
  dueDate     DateTime?  @db.Date
  progress    Int        @default(0)
  tasks       PlanTask[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, status])
  @@index([ownerId, updatedAt])
  @@map("plans")
}

model PlanTask {
  id                 String           @id @default(uuid()) @db.VarChar(36)
  planId             String
  plan               Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  parentId           String?          @db.VarChar(36)
  parent             PlanTask?        @relation("PlanTaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           PlanTask[]       @relation("PlanTaskTree")
  title              String           @db.VarChar(255)
  description        String?          @db.Text
  status             PlanTaskStatus   @default(PENDING)
  priority           PlanTaskPriority @default(MEDIUM)
  estimatedMinutes   Int?
  dueDate            DateTime?        @db.Date
  order              Int              @default(0)
  acceptanceCriteria String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([planId, order])
  @@index([parentId])
  @@index([status, dueDate])
  @@map("plan_tasks")
}

model ChronicleEntry {
  id               String               @id @db.VarChar(64)
  seasonId         String               @db.VarChar(40)
  seasonTitle      String               @db.VarChar(160)
  chapterId        String               @db.VarChar(40)
  chapterTitle     String               @db.VarChar(160)
  recordNumber     Int
  type             String               @db.VarChar(40)
  title            String               @db.VarChar(255)
  subtitle         String?              @db.VarChar(255)
  content          String               @db.Text
  excerpt          String               @db.Text
  author           String?              @db.VarChar(160)
  recordDate       String?              @db.VarChar(80)
  discoverLocation String?              @db.VarChar(255)
  triggerType      String               @db.VarChar(40)
  triggerConfig    Json
  coordinates      Json?
  regionId         String?              @db.VarChar(100)
  soundId          String?              @db.VarChar(40)
  isHidden         Boolean              @default(false)
  discoveries      ChronicleDiscovery[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([seasonId, recordNumber])
  @@index([seasonId, chapterId, recordNumber])
  @@map("chronicle_entries")
}

model ChronicleDiscovery {
  id               String         @id @default(uuid()) @db.VarChar(36)
  ownerId          String         @db.VarChar(160)
  chronicleId      String         @db.VarChar(64)
  chronicle        ChronicleEntry @relation(fields: [chronicleId], references: [id], onDelete: Cascade)
  discoveredAt     DateTime       @default(now())
  discoveryContext Json?
  readAt           DateTime?
  isRead           Boolean        @default(false)

  @@unique([ownerId, chronicleId])
  @@index([ownerId, discoveredAt])
  @@map("chronicle_discoveries")
}

model BookGitSync {
  id                Int           @id @default(autoincrement())
  bookId            Int           @unique
  status            GitSyncStatus @default(NEVER_SYNCED)
  syncedContentHash String?       @db.VarChar(64)
  gitBranch         String?       @db.VarChar(160)
  gitPath           String?       @db.VarChar(500)
  gitCommitSha      String?       @db.VarChar(64)
  lastSyncedAt      DateTime?
  lastError         String?       @db.Text
  book              Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, updatedAt])
  @@map("book_git_syncs")
}

model GitSyncJob {
  id          String           @id @default(uuid()) @db.VarChar(36)
  bookId      Int
  operation   GitSyncOperation @default(UPSERT)
  status      GitSyncStatus    @default(PENDING)
  attempts    Int              @default(0)
  error       String?          @db.Text
  commitSha   String?          @db.VarChar(64)
  book        Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([bookId, createdAt])
  @@map("git_sync_jobs")
}

model GenerationTask {
  id           String               @id @default(uuid()) @db.VarChar(36)
  ownerId      String?              @db.VarChar(160)
  clientRequestId String?           @unique @db.VarChar(64)
  parentTaskId String?              @db.VarChar(36)
  attempt      Int                  @default(1)
  templateId   String               @db.VarChar(100)
  title        String               @db.VarChar(255)
  author       String?              @db.VarChar(160)
  slug         String               @db.VarChar(160)
  provider     String               @db.VarChar(60)
  model        String               @db.VarChar(120)
  status       GenerationStatus     @default(QUEUED)
  progress     Int                  @default(0)
  currentStep  String?              @db.VarChar(160)
  inputJson    Json
  resultJson   Json?
  error        String?              @db.Text
  bookSlug     String?              @db.VarChar(160)
  revisions    GenerationRevision[]
  createdAt    DateTime             @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([ownerId, status, updatedAt])
  @@index([ownerId, slug, status])
  @@index([bookSlug])
  @@map("generation_tasks")
}

model GenerationRevision {
  id          Int            @id @default(autoincrement())
  taskId      String         @db.VarChar(36)
  sectionKey  String         @db.VarChar(100)
  version     Int
  instruction String?        @db.Text
  resultJson  Json
  task        GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([taskId, sectionKey, version])
  @@index([taskId, createdAt])
  @@map("generation_revisions")
}

model AiModelConfig {
  id               String   @id @default(uuid()) @db.VarChar(36)
  apiFormat        String   @default("openai-chat-completions") @db.VarChar(60)
  baseUrl          String   @db.VarChar(500)
  useFullUrl       Boolean  @default(false)
  modelId          String   @db.VarChar(160)
  displayName      String   @db.VarChar(160)
  apiKeyCiphertext String   @db.Text
  apiKeyIv         String   @db.VarChar(64)
  apiKeyAuthTag    String   @db.VarChar(64)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, updatedAt])
  @@map("ai_model_configs")
}

model AiVectorEntry {
  id             String   @id @default(uuid()) @db.VarChar(36)
  key            String   @unique @db.VarChar(255)
  ownerId        String?  @db.VarChar(160)
  type           String   @db.VarChar(24)
  sourceId       String   @db.VarChar(191)
  bookId         Int?
  bookSlug       String?  @db.VarChar(160)
  chapterId      String?  @db.VarChar(191)
  chunkIndex     Int      @default(0)
  title          String   @db.VarChar(255)
  source         String?  @db.VarChar(500)
  content        String   @db.Text
  embedding      Json
  embeddingModel String   @db.VarChar(160)
  sourceCreatedAt DateTime?
  indexedAt      DateTime @default(now()) @updatedAt

  @@index([ownerId, type])
  @@index([bookId, chapterId])
  @@index([type, sourceId])
  @@map("ai_vector_entries")
}
