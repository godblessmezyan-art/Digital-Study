generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  DRAFT
  PUBLISHED
}

enum GenerationStatus {
  QUEUED
  GENERATING
  REVIEWING
  COMPLETED
  FAILED
  CANCELLED
}

model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Book {
  id           Int        @id @default(autoincrement())
  slug         String     @unique @db.VarChar(160)
  title        String     @db.VarChar(255)
  author       String?    @db.VarChar(160)
  summary      String?    @db.Text
  cover        String?    @db.VarChar(255)
  contentPath  String     @db.VarChar(500)
  status       BookStatus @default(DRAFT)
  publishedAt  DateTime?
  categoryId   Int?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("books")
}

model GenerationTask {
  id           String               @id @default(uuid()) @db.VarChar(36)
  templateId   String               @db.VarChar(100)
  title        String               @db.VarChar(255)
  author       String?              @db.VarChar(160)
  slug         String               @db.VarChar(160)
  provider     String               @db.VarChar(60)
  model        String               @db.VarChar(120)
  status       GenerationStatus     @default(QUEUED)
  progress     Int                  @default(0)
  currentStep  String?              @db.VarChar(160)
  inputJson    Json
  resultJson   Json?
  error        String?              @db.Text
  bookSlug     String?              @db.VarChar(160)
  revisions    GenerationRevision[]
  createdAt    DateTime             @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([bookSlug])
  @@map("generation_tasks")
}

model GenerationRevision {
  id          Int            @id @default(autoincrement())
  taskId      String         @db.VarChar(36)
  sectionKey  String         @db.VarChar(100)
  version     Int
  instruction String?        @db.Text
  resultJson  Json
  task        GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([taskId, sectionKey, version])
  @@index([taskId, createdAt])
  @@map("generation_revisions")
}

model AiModelConfig {
  id               String   @id @default(uuid()) @db.VarChar(36)
  apiFormat        String   @default("openai-chat-completions") @db.VarChar(60)
  baseUrl          String   @db.VarChar(500)
  useFullUrl       Boolean  @default(false)
  modelId          String   @db.VarChar(160)
  displayName      String   @db.VarChar(160)
  apiKeyCiphertext String   @db.Text
  apiKeyIv         String   @db.VarChar(64)
  apiKeyAuthTag    String   @db.VarChar(64)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, updatedAt])
  @@map("ai_model_configs")
}
