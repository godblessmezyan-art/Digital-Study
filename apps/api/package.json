{
  "name": "@digital-study/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "sync-content": "ts-node -r tsconfig-paths/register src/scripts/sync-content.ts",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate --schema ../../database/schema.prisma",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate deploy --schema ../../database/schema.prisma",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev --schema ../../database/schema.prisma",
    "prisma:seed": "dotenv -e ../../.env -- ts-node -r tsconfig-paths/register ../../database/seed.ts"
  },
  "dependencies": {
    "@digital-study/shared": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.16.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express": "5.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/node": "24.3.1",
    "dotenv-cli": "10.0.0",
    "prisma": "6.16.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.2"
  }
}
