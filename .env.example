# Local development database connection. Docker Compose overrides the hostname with `db`.
MYSQL_DATABASE=digital_study
MYSQL_USER=digital_study
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DATABASE_URL=mysql://digital_study:change-me@localhost:3306/digital_study

API_PORT=3000
WEB_PORT=8080
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,http://localhost:8080
CONTENT_ROOT=runtime-data/books
TEMPLATES_ROOT=runtime-data/templates
CONTENT_TRASH_ROOT=runtime-data/trash/books
# Optional dedicated clone used only for explicit website -> Git synchronization.
GIT_REPOSITORY_ROOT=git-mirror
GIT_CONTENT_ROOT=git-mirror/content/books
GIT_CONTENT_BRANCH=content
GIT_PUSH_ENABLED=false
GIT_AUTHOR_NAME=Digital Study
GIT_AUTHOR_EMAIL=digital-study@localhost

# Use `mock` for an offline end-to-end test. Switch to `openai-compatible` for a real model.
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_CONCURRENCY=1
AI_TIMEOUT_MS=120000
# Reuse the existing wxhappylife.top/Halo account service for login.
STUDY_AUTH_BASE_URL=https://wxhappylife.top/study/api/auth
# Required when saving provider API Keys from the AI Workshop UI. Keep this stable across deployments.
# Generate a random value with at least 32 characters and never commit the real value.
AI_SETTINGS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
